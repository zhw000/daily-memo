<UserControl x:Class="DailyMemo.Views.ListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DailyMemo.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ListItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,26,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="待办清单" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Google Tasks 的清单会和手机同步；iPhone 的提醒事项开启同步后也会出现在这里" Margin="0,6,0,0" FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,16,0" VerticalAlignment="Top">
                <ListBox ItemsSource="{Binding Lists}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ListItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ListEntryViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding ColorBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <ui:TextBox Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                                PlaceholderText="添加到这个清单，回车保存">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Add20" />
                        </ui:TextBox.Icon>
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource PillBrush}"
                            CornerRadius="10" Padding="8,2" IsHitTestVisible="False"
                            Visibility="{Binding HasQuickHint, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding QuickHint}" FontSize="12" Foreground="{DynamicResource BrandBrush}" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="0,4"
                                Visibility="{Binding IsListEmpty, Converter={StaticResource InverseBoolToVis}}">
                            <ItemsControl ItemsSource="{Binding OpenTasks}" ItemTemplate="{StaticResource ItemRowTemplate}" />
                        </Border>
                        <TextBlock Text="这个清单里没有未完成的待办 ✓" Margin="6,8" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding HasDone, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
                            <TextBlock Text="最近完成" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="0,4">
                                <ItemsControl ItemsSource="{Binding DoneTasks}" ItemTemplate="{StaticResource ItemRowTemplate}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
