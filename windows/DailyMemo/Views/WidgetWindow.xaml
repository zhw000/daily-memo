<Window x:Class="DailyMemo.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DailyMemo.ViewModels"
        Title="今日事 · 小组件" Width="340" Height="460" MinWidth="250" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- 小组件里的一行 -->
        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
            <Border x:Name="Row" CornerRadius="8" Padding="8,6,8,6" Margin="0,1" Background="Transparent"
                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource RoundCheck}" Width="18" Height="18" BorderBrush="{Binding ColorBrush}" HorizontalAlignment="Left"
                              VerticalAlignment="Center" IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding ToggleCommand}"
                              Visibility="{Binding IsTask, Converter={StaticResource BoolToVis}}" />
                    <Border Width="4" Height="18" CornerRadius="2" Background="{Binding ColorBrush}" HorizontalAlignment="Left" Margin="7,0,0,0"
                            Visibility="{Binding IsEvent, Converter={StaticResource BoolToVis}}" />
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TimeText" Grid.Column="2" Text="{Binding TimeText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource WidgetHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPast}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNow}" Value="True">
                    <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource BrandBrush}" />
                    <Setter TargetName="TimeText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WidgetHeaderRow}">
            <TextBlock x:Name="H" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" Margin="8,10,0,3"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="H" Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="WidgetMenu">
            <MenuItem Header="新建待办…" Command="{Binding NewTaskCommand}" />
            <MenuItem Header="新建日程…" Command="{Binding NewEventCommand}" />
            <Separator />
            <MenuItem Header="贴在桌面（被其他窗口遮住）" Command="{Binding SetModeCommand}" CommandParameter="Desktop"
                      IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Desktop}" />
            <MenuItem Header="总在最前" Command="{Binding SetModeCommand}" CommandParameter="Topmost"
                      IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Topmost}" />
            <MenuItem Header="普通窗口" Command="{Binding SetModeCommand}" CommandParameter="Normal"
                      IsChecked="{Binding Mode, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Normal}" />
            <MenuItem Header="锁定位置和大小" Command="{Binding ToggleLockCommand}" IsChecked="{Binding IsLocked, Mode=OneWay}" />
            <Separator />
            <MenuItem Header="立即同步" Command="{Binding RefreshCommand}" />
            <MenuItem Header="打开主界面" Command="{Binding OpenMainCommand}" />
            <MenuItem Header="设置…" Command="{Binding SettingsCommand}" />
            <MenuItem Header="隐藏小组件" Command="{Binding HideCommand}" />
        </ContextMenu>

        <Style x:Key="WidgetInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="10" CornerRadius="16" Background="{DynamicResource WidgetBackgroundBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1" ContextMenu="{StaticResource WidgetMenu}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：拖动区域 -->
            <Grid x:Name="Header" Margin="16,12,10,4" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DayNumber}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}"
                           VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DateText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="立即同步">
                        <ui:SymbolIcon x:Name="SyncIcon" Symbol="ArrowSync20" FontSize="15" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenMainCommand}" ToolTip="打开主界面">
                        <ui:SymbolIcon Symbol="Open20" FontSize="15" />
                    </Button>
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Click="MenuButton_Click" ToolTip="更多">
                        <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 今日进度 -->
            <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="16,0,16,0" Height="3" x:Name="ProgressTrack" Visibility="Collapsed">
                <Border Background="{DynamicResource WidgetHoverBrush}" CornerRadius="1.5" />
                <Border x:Name="ProgressBar" Background="{DynamicResource SuccessBrush}" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
            </Grid>

            <!-- 列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,2,4,0" Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Rows}" />
            </ScrollViewer>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="34" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="今天没有安排" FontSize="14" Margin="0,8,0,2" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="在下面记一件事吧" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- 快速添加 -->
            <Border Grid.Row="2" Margin="12,6,12,12" CornerRadius="10" Background="{DynamicResource WidgetHoverBrush}" Padding="10,0" Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Add20" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBox x:Name="QuickBox" Grid.Column="1" Style="{StaticResource WidgetInput}"
                             Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Column="1" Text="记一件事，回车保存" FontSize="13" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding QuickText, Converter={StaticResource TextToVis}, ConverterParameter=inverse}" x:Name="Placeholder" />
                    <Border Grid.Column="2" Background="{DynamicResource PillBrush}" CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                            Visibility="{Binding HasQuickHint, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding QuickHint}" FontSize="11" Foreground="{DynamicResource BrandBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
