<UserControl x:Class="DailyMemo.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Margin="36,26,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DateTitle}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Weekday}" FontSize="18" Margin="12,0,0,5" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Background="{DynamicResource PillBrush}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0"
                            Visibility="{Binding HasNextUp, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock20" FontSize="14" Foreground="{DynamicResource BrandBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding NextUp}" Foreground="{DynamicResource BrandBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,4"
                            Visibility="{Binding ProgressText, Converter={StaticResource TextToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="60" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border Background="{DynamicResource ControlStrongFillColorDisabledBrush}" CornerRadius="3" />
                                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                        Width="{Binding Progress, Converter={StaticResource ProgressWidth}, ConverterParameter=60}" />
                            </Grid>
                            <TextBlock Text="{Binding ProgressText}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <ui:Button Content="新建日程" Icon="{ui:SymbolIcon CalendarAdd20}" Command="{Binding NewEventCommand}" Margin="0,0,8,0" />
                <ui:Button Content="新建待办" Icon="{ui:SymbolIcon Add20}" Appearance="Primary" Command="{Binding NewTaskCommand}" />
            </StackPanel>
        </Grid>

        <!-- 快速添加 -->
        <Grid Grid.Row="1" Margin="36,20,36,16">
            <ui:TextBox x:Name="QuickBox" Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" FontSize="14"
                        PlaceholderText="记一件事，回车保存 · 可以直接写「明天下午3点 交报告」「周五 买菜」" ClearButtonEnabled="False">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Add20" />
                </ui:TextBox.Icon>
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding QuickAddCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource PillBrush}"
                    CornerRadius="10" Padding="8,2" IsHitTestVisible="False"
                    Visibility="{Binding HasQuickHint, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="12" Foreground="{DynamicResource BrandBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding QuickHint}" FontSize="12" Foreground="{DynamicResource BrandBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,2,36,24">
            <Grid>
                <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" />
                <StackPanel HorizontalAlignment="Center" Margin="0,70,0,0" MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="WeatherSunny24" FontSize="52" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="今天没有安排" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="在上面的输入框里记一件事；或者去「设置」连接 Google / iCloud，把手机上的日历和提醒事项同步过来。" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
