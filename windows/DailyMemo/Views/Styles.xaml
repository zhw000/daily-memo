<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:v="clr-namespace:DailyMemo.Views"
                    xmlns:vm="clr-namespace:DailyMemo.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <v:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
    <v:InverseBoolConverter x:Key="InverseBool" />
    <v:EnumEqualsConverter x:Key="EnumEquals" />
    <v:TextToVisConverter x:Key="TextToVis" />
    <v:ProgressWidthConverter x:Key="ProgressWidth" />

    <!-- 运行时由 ThemeService 按浅色/深色覆盖 -->
    <SolidColorBrush x:Key="BrandBrush" Color="#4C6EF5" />
    <SolidColorBrush x:Key="OverdueBrush" Color="#D93636" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E5A" />
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#E6F8F9FC" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#22000000" />
    <SolidColorBrush x:Key="WidgetHoverBrush" Color="#10000000" />
    <SolidColorBrush x:Key="PillBrush" Color="#1F4C6EF5" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- 圆形勾选框（颜色取自 BorderBrush） -->
    <Style x:Key="RoundCheck" TargetType="CheckBox">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" Margin="1" />
                            <Ellipse x:Name="Fill" Fill="{TemplateBinding BorderBrush}" Margin="1" Visibility="Collapsed" />
                            <Path x:Name="Mark" Data="M 5.8,10.3 L 8.8,13.2 L 14.4,7.2" Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Opacity="0.55" />
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Mark" Property="Stroke" Value="White" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 透明小图标按钮 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 像链接一样的按钮 -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Cp" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Cp" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分段选择（待办 / 日程） -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="14,6" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrandBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小圆角「胶囊」按钮（今天 / 明天 …） -->
    <Style x:Key="ChipButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主界面列表行 -->
    <DataTemplate x:Key="ItemRowTemplate" DataType="{x:Type vm:ItemViewModel}">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,8,6,8" Margin="4,1"
                ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource RoundCheck}" BorderBrush="{Binding ColorBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsChecked="{Binding IsCompleted, Mode=OneWay}" Command="{Binding ToggleCommand}"
                          Visibility="{Binding IsTask, Converter={StaticResource BoolToVis}}" />
                <Border Width="4" CornerRadius="2" Background="{Binding ColorBrush}" HorizontalAlignment="Left" Margin="8,2,0,2"
                        Visibility="{Binding IsEvent, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <WrapPanel Margin="0,3,0,0">
                        <TextBlock x:Name="TimeText" Text="{Binding TimeText}" FontSize="12" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasTimeText, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="Location16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,2,0" />
                            <TextBlock Text="{Binding Location}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,0" Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="ArrowRepeatAll16" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Hidden">
                    <Button Style="{StaticResource IconButton}" Command="{Binding EditCommand}" ToolTip="编辑">
                        <ui:SymbolIcon Symbol="Edit20" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="删除"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Delete20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPast}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource OverdueBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNow}" Value="True">
                <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource BrandBrush}" />
                <Setter TargetName="TimeText" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 分组卡片 -->
    <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:SectionViewModel}">
        <StackPanel Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="6,0,0,8">
                <TextBlock x:Name="Header" Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border x:Name="Pill" Background="{DynamicResource PillBrush}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Count" Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource BrandBrush}" />
                </Border>
                <TextBlock Text="{Binding Hint}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Hint, Converter={StaticResource TextToVis}}" />
            </StackPanel>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="0,4">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRowTemplate}" />
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter TargetName="Header" Property="Foreground" Value="{DynamicResource OverdueBrush}" />
                <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource OverdueBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 卡片容器（设置页等） -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

</ResourceDictionary>
