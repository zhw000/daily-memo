<UserControl x:Class="DailyMemo.Views.UpcomingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DailyMemo.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="36,26,36,18">
            <StackPanel>
                <TextBlock Text="未来两周" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="提前看看接下来要做什么" Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ui:Button Content="新建日程" Icon="{ui:SymbolIcon CalendarAdd20}" Command="{Binding NewEventCommand}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,36,24">
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayGroupViewModel}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="4,10,12,0">
                                <TextBlock x:Name="Header" Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Sub}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0,4"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemRowTemplate}" />
                            </Border>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                                    Height="44" Opacity="0.7" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="空闲" FontSize="12" VerticalAlignment="Center" Margin="16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                <Setter TargetName="Header" Property="Foreground" Value="{DynamicResource BrandBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
